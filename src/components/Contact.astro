---
---

<section id="contact">
  <div class="section-header">
    <span class="section-num">04</span>
    <h2>GAME OVER?</h2>
    <div class="section-line"></div>
  </div>

  <div class="continue-box">
    <h3 class="continue-heading">CONTINUE?</h3>
    <p class="subtitle">Let's build something great together</p>

    <div class="timer-row">
      <span class="timer-label">TIME REMAINING:</span>
      <span id="timer" class="timer-value">9</span>
    </div>

    <form id="contact-form">
      <div class="field">
        <label for="cf-name">NAME</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="cf-email">EMAIL</label>
        <input id="cf-email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="cf-message">MESSAGE</label>
        <textarea id="cf-message" name="message" required rows="4" maxlength="1000"></textarea>
      </div>
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" aria-hidden="true" />
      <button type="submit" id="cf-submit" class="btn btn-primary">&#x25BA; SEND MESSAGE</button>
      <p id="cf-error" class="cf-error" role="alert" hidden>TRANSMISSION FAILED &#x25B8; TRY EMAIL ME</p>
    </form>

    <div id="cf-success" class="cf-success" hidden>
      <p class="cf-success-msg">MESSAGE SENT &#x25B8; NEW HIGH SCORE!</p>
      <a href="#" id="cf-again" class="cf-again">&#x25BA; SEND ANOTHER</a>
    </div>

    <div class="ctas">
      <a href="mailto:hekleiman@gmail.com" class="btn btn-primary">EMAIL ME</a>
      <a href="https://github.com/Hekleiman" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">GITHUB</a>
      <a href="https://linkedin.com/in/henry-erik-kleiman-85aa99288" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">LINKEDIN</a>
    </div>

    <p class="response-time">RESPONSE TIME: UNDER 24 HOURS</p>
  </div>
</section>

<style>
  section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 56px 24px;
    text-align: center;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 48px;
  }

  .section-num {
    font-family: 'VT323', monospace;
    font-size: 48px;
    color: var(--snes-purple);
    line-height: 1;
  }

  .section-header h2 {
    font-family: 'Press Start 2P', monospace;
    font-size: 14px;
    color: var(--pixel-yellow);
    white-space: nowrap;
  }

  .section-line {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--snes-purple), transparent);
  }

  .continue-box {
    display: inline-block;
    max-width: 100%;
    border: 3px solid var(--neon-cyan);
    padding: 48px 64px;
    background: rgba(0, 229, 255, 0.03);
    box-shadow:
      0 0 40px rgba(0, 229, 255, 0.1),
      inset 0 0 40px rgba(0, 229, 255, 0.03);
  }

  @media (max-width: 700px) {
    .continue-box {
      padding: 32px 20px;
    }
  }

  .continue-heading {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(14px, 3vw, 22px);
    color: #fff;
    margin-bottom: 12px;
  }

  .continue-heading.credit {
    color: var(--neon-green);
  }

  .subtitle {
    font-family: 'VT323', monospace;
    font-size: 20px;
    color: var(--ps1-grey);
    margin-bottom: 24px;
  }

  .timer-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .timer-label {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    color: var(--ps1-grey);
  }

  .timer-value {
    font-family: 'VT323', monospace;
    font-size: 28px;
    color: var(--hp-red);
    text-shadow: 0 0 10px rgba(255, 34, 68, 0.6);
  }

  /* Arcade high-score contact form */
  #contact-form {
    max-width: 420px;
    width: 100%;
    margin: 0 auto 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: left;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  #contact-form label {
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    color: var(--ps1-grey);
    letter-spacing: 1px;
  }

  #contact-form input,
  #contact-form textarea {
    width: 100%;
    font-family: 'VT323', monospace;
    font-size: 18px;
    color: var(--neon-green);
    background: rgba(106, 13, 173, 0.08);
    border: 2px solid var(--snes-purple);
    padding: 10px;
  }

  #contact-form textarea {
    resize: vertical;
  }

  #contact-form input:focus,
  #contact-form textarea:focus {
    border-color: var(--neon-cyan);
  }

  #cf-submit {
    align-self: center;
    border: none;
    margin-top: 2px;
  }

  .cf-error {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    line-height: 1.6;
    color: var(--hp-red);
    text-align: center;
    margin-top: 4px;
  }

  .cf-success {
    max-width: 420px;
    margin: 0 auto 24px;
  }

  .cf-success-msg {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    line-height: 1.6;
    color: var(--neon-green);
    margin-bottom: 14px;
  }

  .cf-again {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    color: var(--neon-green);
    text-decoration: none;
  }

  .cf-again:hover {
    color: var(--pixel-yellow);
  }

  .ctas {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .btn {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    padding: 14px 24px;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--neon-green);
    color: var(--screen-bg);
    box-shadow: 4px 4px 0 #1a8c00;
  }

  .btn-primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 #1a8c00;
  }

  .btn-secondary {
    background: transparent;
    color: var(--neon-cyan);
    border: 2px solid var(--neon-cyan);
    box-shadow: 4px 4px 0 #006b80;
  }

  .btn-secondary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 #006b80;
  }

  .response-time {
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    color: var(--ps1-grey);
  }
</style>

<script is:inline>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    var count = 9;
    var paused = false;
    var timerEl = document.getElementById("timer");
    var box = document.querySelector(".continue-box");
    var heading = document.querySelector(".continue-heading");
    setInterval(function() {
      if (paused) return;
      count = count > 0 ? count - 1 : 9;
      timerEl.textContent = count;
      if (count === 0) {
        // Countdown payoff: glitch the box, flash CREDIT ACCEPTED, then reset.
        paused = true;
        box.classList.add("glitching");
        setTimeout(function () { box.classList.remove("glitching"); }, 600);
        heading.textContent = "CREDIT ACCEPTED";
        heading.classList.add("credit");
        setTimeout(function () {
          heading.textContent = "CONTINUE?";
          heading.classList.remove("credit");
          count = 9;
          timerEl.textContent = count;
          paused = false;
        }, 1200);
      }
    }, 1000);
  }
</script>

<script is:inline>
  (function () {
    var form = document.getElementById("contact-form");
    if (!form) return;
    var btn = document.getElementById("cf-submit");
    var errEl = document.getElementById("cf-error");
    var success = document.getElementById("cf-success");
    var again = document.getElementById("cf-again");
    var ENDPOINT = "https://formspree.io/f/xqerepzb";

    form.addEventListener("submit", function (e) {
      // Native validation runs first; this handler only fires when the form is valid.
      e.preventDefault();
      errEl.hidden = true;
      var original = btn.textContent;
      btn.disabled = true;
      btn.textContent = "SENDING...";
      fetch(ENDPOINT, {
        method: "POST",
        headers: { "Accept": "application/json" },
        body: new FormData(form)
      }).then(function (res) {
        if (!res.ok) throw new Error("HTTP " + res.status);
        form.hidden = true;
        success.hidden = false;
      }).catch(function () {
        errEl.hidden = false; // keep the user's input intact
      }).finally(function () {
        btn.disabled = false;
        btn.textContent = original;
      });
    });

    again.addEventListener("click", function (e) {
      e.preventDefault();
      form.reset();
      success.hidden = true;
      form.hidden = false;
      errEl.hidden = true;
      var first = document.getElementById("cf-name");
      if (first) first.focus();
    });
  })();
</script>
